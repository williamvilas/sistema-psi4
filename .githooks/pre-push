#!/bin/bash
# Roda os testes unitários antes do push. Se algum falhar, o push é bloqueado.

cd "$(git rev-parse --show-toplevel)" || exit 1

echo "[pre-push] Rodando testes unitários..."

php artisan test --testsuite=Unit

if [ $? -ne 0 ]; then
    echo ""
    echo "[pre-push] Testes unitários falharam. Push bloqueado."
    echo "[pre-push] Corrija os testes (verifique também se o banco de testes está disponível)."
    exit 1
fi

exit 0
