APP_NAME="PSI4"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://stage.psi4.com.br

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

# Laravel Octane (Swoole). Workers/max-requests vêm do Dockerfile e dos
# docker-compose (OCTANE_WORKERS, OCTANE_MAX_REQUESTS).
OCTANE_SERVER=swoole
#APP_PORT=9090

API_INTEGRATION_MICROSERVICE=http://localhost:8080

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=sistema_psi
DB_USERNAME=psi
DB_PASSWORD=changeme
# Usado apenas pelo container MySQL do Docker (docker-compose*.yml) para criar o usuário root.
DB_ROOT_PASSWORD=changeme_root_password

# Porta exposta pelo nginx no ambiente local do Docker (docker-compose.yml).
APP_PORT=80

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sessão só via HTTPS. Sem valor, fica true fora do APP_ENV=local.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

### FILESYSTEM ####
#FILESYSTEM_DISK=public
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=sa-east-1
AWS_BUCKET=psi-saas-dev
AWS_USE_PATH_STYLE_ENDPOINT=false

# Transcrição das sessões. Ligue só depois de validar a Fase 0 (jitsi-meet-psi/scripts/psi/transcribe-spike/README.md).
PSI_TRANSCRIPTION_ENABLED=false
# Credenciais IAM exclusivas da transcrição (ver config/session_transcription.php): a do uploader só assina o PUT
# do áudio, a do worker roda o Transcribe, o Bedrock e apaga os temporários. Não reaproveitar a do S3 dos prontuários.
# O navegador recebe só a URL assinada, nunca a chave.
PSI_TRANSCRIBE_AWS_REGION=sa-east-1
PSI_TRANSCRIPTION_BUCKET=
PSI_TRANSCRIPTION_KMS_KEY_ID=
PSI_TRANSCRIPTION_UPLOADER_AWS_ACCESS_KEY_ID=
PSI_TRANSCRIPTION_UPLOADER_AWS_SECRET_ACCESS_KEY=
PSI_TRANSCRIPTION_WORKER_AWS_ACCESS_KEY_ID=
PSI_TRANSCRIPTION_WORKER_AWS_SECRET_ACCESS_KEY=
PSI_TRANSCRIPTION_BEDROCK_REGION=sa-east-1
PSI_TRANSCRIPTION_BEDROCK_MODEL=anthropic.claude-opus-5-5

# Segredo compartilhado com o microserviço de integrações (mesmo valor nos dois .env).
# Gere com: openssl rand -base64 48. Validade da autorização em segundos (30 min; o navegador guarda na sessão).
AI_GRANT_SECRET=
AI_GRANT_TTL=1800

MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_SANDBOX=true
MERCADOPAGO_WEBHOOK_KEY=
# Loga o cURL completo (com token/Authorization em texto puro) de cada
# requisição ao Mercado Pago. Uso exclusivo de depuração local — NUNCA true em produção.
MERCADOPAGO_DEBUG=false

# Credenciais OAuth da aplicação Mercado Pago da PSI4 (DevPanel -> sua aplicação
# -> "Chaves para OAuth") — distintas do access token acima. Usadas para
# conectar a conta Mercado Pago de cada terapeuta (Mercado Pago Connect).
# O Mercado Pago só aceita redirect_uri em HTTPS e exige correspondência exata
# com a "URL de redirecionamento" cadastrada na aplicação (Configurações
# avançadas), senão a autorização falha com "não foi possível conectar o
# aplicativo à sua conta".
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
MERCADOPAGO_OAUTH_REDIRECT_URI=https://stage.psi4.com.br/settings/payment-account/callback

# Login com Google (Google Cloud Console -> APIs e serviços -> Credenciais -> ID do cliente OAuth).
# A URI de redirecionamento autorizada deve ser exatamente: https://<dominio>/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://stage.psi4.com.br/auth/google/callback
GOOGLE_CALENDAR_REDIRECT_URI=https://stage.psi4.com.br/settings/google-calendar/callback

# Salas de vídeo das consultas online no Jitsi do PSI4, com acesso por telefone
# (agenda, API /api/video-rooms e /api/video-room/access)
# URL pública do Jitsi usada para montar o link da sala (sem barra no final)
PSI_VIDEO_JITSI_BASE_URL=https://meet.psi4.com.br
# Credenciais do Prosody (mod_auth_token). DEVEM ser iguais a app_id/app_secret do Prosody.
PSI_VIDEO_JITSI_APP_ID=psi
PSI_VIDEO_JITSI_APP_SECRET=troque-por-um-segredo-longo-e-aleatorio
# Claim "sub" do JWT: domínio XMPP do Jitsi (ex.: meet.psi). Use "*" para aceitar qualquer um.
PSI_VIDEO_JITSI_SUB=meet.psi4.com.br
PSI_VIDEO_JITSI_AUD=jitsi
# Token de serviço (Authorization: Bearer) das rotas internas /api/video-rooms
PSI_VIDEO_API_TOKEN=troque-por-um-token-longo-e-aleatorio
# Chaves dos HMACs de CPF e telefone (32+ bytes aleatórios cada). Trocar invalida as credenciais daquele tipo nas salas existentes.
PSI_VIDEO_CPF_PEPPER=troque-por-32-bytes-aleatorios
PSI_VIDEO_PHONE_PEPPER=troque-por-32-bytes-aleatorios
# Janela de acesso em minutos. Deixe vazio para não limitar aquele lado (entrada a qualquer horário); 0 = exatamente no horário
PSI_VIDEO_ACCESS_OPENS_BEFORE_MINUTES=15
PSI_VIDEO_ACCESS_CLOSES_AFTER_MINUTES=30
# Segredo das dinâmicas da sala (autorização de gravação e chave do rascunho no navegador): openssl rand -base64 48
PSI_ACTIVITY_DRAFT_SECRET=
# Origem(ns) do front do Jitsi para CORS, separadas por vírgula
PSI_VIDEO_CORS_ORIGINS=https://meet.psi4.com.br

# Login com LinkedIn (LinkedIn Developers -> app -> produto "Sign In with LinkedIn using OpenID Connect").
# A URL de redirecionamento autorizada deve ser exatamente: https://<dominio>/auth/linkedin/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://stage.psi4.com.br/auth/linkedin/callback

LEGAL_COMPANY_NAME=
LEGAL_COMPANY_DOCUMENT=
LEGAL_DPO_EMAIL=
LEGAL_FORUM=

# Cadastro só por convite: sem convite, a pessoa deixa Nome e WhatsApp para receber um.
REGISTRATION_INVITE_ONLY=false
REGISTRATION_INVITE_TTL_DAYS=14

# Avisos automáticos pela API oficial do WhatsApp (Cloud API da Meta), ver config/whatsapp.php.
# Webhook no app da Meta: GET/POST {APP_URL}/api/webhook/whatsapp (campo "messages").
WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
LANDING_HOW_IT_WORKS_VIDEO_URL=
